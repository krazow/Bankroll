{
  "name": "Bankroll",
  "short_name": "Bankroll",
  "description": "Personal poker session and bankroll tracker.",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f1412",
  "theme_color": "#0f1412",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Start session", "short_name": "Start", "url": "./#/new?live=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Running session", "short_name": "Live", "url": "./#/live", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log past session", "short_name": "Log", "url": "./#/new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
